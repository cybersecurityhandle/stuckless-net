# Visit analytics (Upstash Redis) — create a free database at https://console.upstash.com
# and copy the REST credentials. Set these in Vercel → Project → Settings → Environment Variables.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Secret for the private dashboard: https://stuckless.net/analytics?key=<this value>
ANALYTICS_SECRET=
