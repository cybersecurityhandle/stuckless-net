# Upstash Redis for the stock API cache — create a free database at https://console.upstash.com
# and copy the REST credentials. Set these in Vercel → Project → Settings → Environment Variables.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional third-party page-view script, loaded on every page when set
NEXT_PUBLIC_ANALYTICS_SRC=
